# ---------------------------------------------------------------------------
# X sentiment -> asset price prediction pipeline
#
# Copy this file to `.env` and fill in the required values.  Never commit `.env`.
# Empty values are treated as unset by pydantic-settings.
# ---------------------------------------------------------------------------

# Application / asset scope (REQUIRED: ASSET_SYMBOL, ASSET_TYPE)
APP_NAME=crowdxbot
ENVIRONMENT=development
# Examples: AAPL, TSLA, BTC-USD, EURUSD, GC=F, ^GSPC
ASSET_SYMBOL=
# equity | crypto | fx | commodity | index
ASSET_TYPE=
# IANA timezone used for daily bucketing; UTC is a safe default.
TIMEZONE=UTC
# Used only when DATA_START_DATE is unset.
HISTORY_DAYS=180
# Optional ISO dates (YYYY-MM-DD). Leave blank to derive from HISTORY_DAYS/today.
DATA_START_DATE=
DATA_END_DATE=
# yfinance (provider adapters are replaceable in src/ingestion/prices.py).
DATA_PROVIDER=yfinance

# X ingestion through Apify (REQUIRED: APIFY_ACTOR_ID, APIFY_API_TOKEN)
# Use the verified actor ID from the actor's Apify page, e.g. user/actor-name.
APIFY_ACTOR_ID=apidojo/tweet-scraper
# Store secrets in the environment or a secret manager only.
APIFY_API_TOKEN=
APIFY_MAX_ITEMS=1000
APIFY_RUN_TIMEOUT_SECONDS=300
APIFY_POLL_INTERVAL_SECONDS=5
# Actor input template (REQUIRED for ingest-x; use exactly one of inline JSON or a file).
# Inspect the actor's INPUT_SCHEMA.json first; never guess field names.
# Placeholders: {query}, {query_terms}, {max_items}, {asset_symbol}, {asset_type},
# {asset_slug}, {start_date}, {end_date}, {since}, {until}, {language}
# Example: APIFY_INPUT_TEMPLATE={"searchTerms": ["{query}"], "maxTweets": {max_items}}
# Verified example for apidojo/tweet-scraper (input schema checked 2026-11-02):
# APIFY_INPUT_TEMPLATE={"searchTerms":["{query}"],"maxItems":"{max_items}","sort":"Latest"}
APIFY_INPUT_TEMPLATE=
# Path to a JSON file containing the same template. Relative paths resolve to the project root.
APIFY_INPUT_TEMPLATE_PATH=
# Optional verified INPUT_SCHEMA.json for local payload validation.
APIFY_INPUT_SCHEMA_PATH=
# Optional canonical field -> actor dataset JSON path overrides, e.g.
# APIFY_OUTPUT_FIELD_MAP={"text": "legacy.full_text", "created_at": "legacy.created_at"}
APIFY_OUTPUT_FIELD_MAP={}
# cashtag_and_symbol | cashtag_only | symbol_only
APIFY_QUERY_MODE=cashtag_and_symbol
# Comma-separated aliases for disambiguation, e.g. "Apple Inc,Apple"
APIFY_QUERY_TERMS=
# Comma-separated terms excluded from the X query, e.g. "giveaway,airdrop"
APIFY_QUERY_EXCLUDE_TERMS=
# Optional X language filter, e.g. en.
APIFY_QUERY_LANGUAGE=

# News retrieval (REQUIRED: TAVILY_API_KEY)
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=10
# basic | advanced
TAVILY_SEARCH_DEPTH=basic
# Optional; leave blank to disable Exa.
EXA_API_KEY=
EXA_MAX_RESULTS=10
NEWS_LOOKBACK_DAYS=7
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3

# Storage. Relative SQLite paths are resolved against the project root.
DATABASE_URL=sqlite:///data/processed/crowdxbot.db
SQLITE_BUSY_TIMEOUT_MS=5000

# Modelling. Horizons are comma-separated trading-day steps after n+0.
MODEL_TYPE=xgboost
MODEL_HORIZONS=1,2,3,4,5
MODEL_RANDOM_SEED=42
MODEL_N_ESTIMATORS=60
MODEL_MAX_DEPTH=2
MODEL_LEARNING_RATE=0.05
WALK_FORWARD_INITIAL_TRAIN_DAYS=120
WALK_FORWARD_TEST_DAYS=5
# Must be at least the largest MODEL_HORIZONS value.
WALK_FORWARD_GAP_DAYS=5
MIN_TRAIN_SAMPLES=60
TRANSACTION_COST_BPS=10
RISK_FREE_RATE=0.0

# Sentiment model (pinned in model metadata at scoring time)
SENTIMENT_MODEL_NAME=ProsusAI/finbert
SENTIMENT_MODEL_REVISION=main
SENTIMENT_BATCH_SIZE=32
SENTIMENT_MAX_LENGTH=128
# auto | cpu | cuda | mps
SENTIMENT_DEVICE=auto

# Output paths (relative values resolve against the project root)
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
MODELS_DIR=models
REPORTS_DIR=reports
ARTIFACTS_DIR=artifacts
LOGS_DIR=logs

# Logging. The rotating file log is always JSON; this controls the console.
LOG_LEVEL=INFO
# console | json
LOG_FORMAT=console
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Test/automation hook: point pydantic-settings at a different dotenv file.
# CROWDXBOT_ENV_FILE=
